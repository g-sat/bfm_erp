# BOLDFRAME backend environment
# Copy to .env and fill in your free Neon (or Supabase) Postgres URL.

SECRET_KEY=bfm-erp-dev-secret-change-in-production

# Free cloud Postgres — Neon: https://neon.tech  (recommended)
# Dashboard → your project → Connection string → URI
# Example shape:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Leave DATABASE_URL empty to fall back to local SQLite (./bfm_erp.db)

# Comma-separated browser origins allowed to call the API directly.
# Include your Vercel URL after frontend deploy (rewrites still work without this).
# CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
